# Database
# Replace with your PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/vinathletics
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vinathletics"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
