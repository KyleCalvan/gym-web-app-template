# Copy to .env.local at the repository root. Next.js and Prisma commands both
# read this configuration. The integration suite supplies its own disposable DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Auth.js v4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-from-openssl-rand-base64-32

# Development-only demo users. The server disables this endpoint in production.
DEMO_ACCOUNTS_ENABLED=true
# Optional override; development uses a local-only fallback if this and NEXTAUTH_SECRET are unset.
DEMO_SESSION_SECRET=

# Gym timezone used for booking date validation
NEXT_PUBLIC_BOOKING_TIME_ZONE=Asia/Manila

# Explicit test-only flat fee applied to simulated GCash payments (PHP)
NEXT_PUBLIC_GCASH_TEST_FEE_PHP=0

# Google Cloud OAuth web client credentials (never expose the secret in NEXT_PUBLIC_*).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verification email for password registration via Gmail SMTP.
# SMTP_USER is the sending Gmail address; SMTP_PASSWORD is its Google App Password without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VinAthletics <your-gmail-address@gmail.com>

# Assigned Roles are persisted in PostgreSQL, not controlled by environment.
# For an existing installation only, preserve old ADMIN_EMAILS/ROLE_ASSIGNMENTS
# until their reviewed one-time import. See docs/account-cutover.md.

# Maximum active membership plans. Defaults to 4 if omitted.
ACTIVE_PLAN_LIMIT=4

# PayMongo Hosted Checkout test mode. Keep these server-side; never use NEXT_PUBLIC_ here.
PAYMONGO_SECRET_KEY=
# Required for signed webhook delivery when a public HTTPS endpoint is available.
PAYMONGO_WEBHOOK_SECRET=
