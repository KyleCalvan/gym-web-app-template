{
  "name": "vinathletics-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=./backend/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:promotions": "node --experimental-strip-types --test tests/promotion-eligibility.test.mjs tests/promotion-visibility.test.mjs tests/promotion-redemption.test.mjs tests/plan-comparison.test.mjs",
    "db:migrate": "prisma migrate deploy --schema=./backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^5.14.0",
    "@prisma/client": "^5.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^1.34.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.0"
  }
}
