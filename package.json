{
  "name": "vinathletics-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "next dev -p 3000",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:promotions": "node --experimental-strip-types --test tests/promotion-eligibility.test.mjs tests/promotion-visibility.test.mjs tests/promotion-redemption.test.mjs tests/plan-comparison.test.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:status": "node scripts/prisma.mjs migrate status"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "5.22.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "animejs": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^1.34.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "5.22.0",
    "typescript": "^5.4.0"
  }
}
